[Unit]
Description=@APP_NAME@ port forwarding table
Documentation=https://github.com/rm-networks/kvm-studio/blob/main/docs/NETWORKING.md
# "systemctl restart nftables" can flush every table and firewalld rebuilds
# its own: the inet kvmstudio table is written again after each. libvirt is
# left out (virtnetworkd conflicts with libvirtd, PartOf would make their
# restart fail); its network hook writes the table when a network starts.
After=nftables.service firewalld.service
PartOf=nftables.service firewalld.service
ReloadPropagatedFrom=nftables.service firewalld.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/kvm-studio/bin/kvmstudio-helper --apply-forwards
ExecReload=/opt/kvm-studio/bin/kvmstudio-helper --apply-forwards

[Install]
WantedBy=multi-user.target
