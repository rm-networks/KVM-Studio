[Unit]
Description=@APP_NAME@ port forwarding table
Documentation=https://github.com/rm-networks/kvm-studio/blob/main/docs/NETWORKING.md
# "systemctl restart nftables" can flush every table and firewalld rebuilds
# its own: the inet kvmstudio table is written again after each. libvirt is
# left out (virtnetworkd conflicts with libvirtd, PartOf would make their
# restart fail); its network hook writes the table when a network starts.
After=nftables.service firewalld.service
PartOf=nftables.service firewalld.service
ReloadPropagatedFrom=nftables.service firewalld.service

[Service]
Type=oneshot
RemainAfterExit=yes
# At boot nothing is shared yet: a LAN sharing port left open (ufw rules last,
# older versions also opened it permanently in firewalld) is closed.
ExecStartPre=-/opt/kvm-studio/bin/kvmstudio-helper --close-lan-port
ExecStart=/opt/kvm-studio/bin/kvmstudio-helper --apply-forwards
ExecReload=/opt/kvm-studio/bin/kvmstudio-helper --apply-forwards
# Same code as the helper, as root: the same confinement.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
