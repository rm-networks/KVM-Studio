[Unit]
Description=@APP_NAME@ privileged helper
Documentation=https://github.com/rm-networks/kvm-studio/blob/main/docs/ARCHITECTURE.md
Requires=kvmstudio-helper.socket

[Service]
ExecStart=/opt/kvm-studio/bin/kvmstudio-helper
# Started on demand by the socket.
NoNewPrivileges=yes
# usermod writes /etc/group and /etc/gshadow.
ProtectSystem=true
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_FOWNER CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_AUDIT_WRITE
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
