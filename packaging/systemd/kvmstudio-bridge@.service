[Unit]
Description=@APP_NAME@ port forwarding for bridge %i
Documentation=https://github.com/rm-networks/kvm-studio/blob/main/docs/NETWORKING.md
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
ExecStart=/opt/kvm-studio/bin/kvmstudio-helper --apply-forwards
# Same code as the helper, as root: the same confinement.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
