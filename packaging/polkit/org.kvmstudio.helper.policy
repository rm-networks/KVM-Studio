<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>@APP_NAME@</vendor>
  <vendor_url>https://github.com/rm-networks/kvm-studio</vendor_url>

  <action id="org.kvmstudio.helper.iso-acl">
    <description>Let virtual machines read an ISO image</description>
    <description xml:lang="fr">Permettre aux machines virtuelles de lire une image ISO</description>
    <message>Authentication is required to change the access rights of an ISO library.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier les droits d'accès d'une bibliothèque ISO.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.kvmstudio.helper.iso-library">
    <description>Declare or remove an ISO library</description>
    <description xml:lang="fr">Déclarer ou retirer une bibliothèque ISO</description>
    <message>Authentication is required to change the ISO libraries virtual machines can read.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier les bibliothèques ISO lisibles par les machines virtuelles.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.kvmstudio.helper.port-forward">
    <description>Change the port forwarding of a NAT network</description>
    <description xml:lang="fr">Modifier la redirection de ports d'un réseau NAT</description>
    <message>Authentication is required to change the port forwarding of a virtual network.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier la redirection de ports d'un réseau virtuel.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.kvmstudio.helper.clone-state">
    <description>Copy the firmware variables and TPM state of a cloned virtual machine</description>
    <description xml:lang="fr">Copier les variables du firmware et l'état du TPM d'une machine virtuelle clonée</description>
    <message>Authentication is required to copy the firmware variables and TPM state of a virtual machine.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour copier les variables du firmware et l'état du TPM d'une machine virtuelle.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.kvmstudio.helper.join-libvirt">
    <description>Add your account to the libvirt group</description>
    <description xml:lang="fr">Ajouter votre compte au groupe libvirt</description>
    <message>Authentication is required to add your account to the libvirt group.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour ajouter votre compte au groupe libvirt.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.kvmstudio.helper.remove-package">
    <description>Uninstall @APP_NAME@</description>
    <description xml:lang="fr">Désinstaller @APP_NAME@</description>
    <message>Authentication is required to uninstall @APP_NAME@.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour désinstaller @APP_NAME@.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
