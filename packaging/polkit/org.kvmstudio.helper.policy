<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>KVM Studio</vendor>
  <vendor_url>https://github.com/rm-networks/kvm-studio</vendor_url>

  <action id="org.kvmstudio.helper.iso-acl">
    <description>Let virtual machines read an ISO image</description>
    <description xml:lang="fr">Permettre aux machines virtuelles de lire une image ISO</description>
    <message>Authentication is required to change the access rights of an ISO library.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier les droits d'accès d'une bibliothèque ISO.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.kvmstudio.helper.join-libvirt">
    <description>Add your account to the libvirt group</description>
    <description xml:lang="fr">Ajouter votre compte au groupe libvirt</description>
    <message>Authentication is required to add your account to the libvirt group.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour ajouter votre compte au groupe libvirt.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
