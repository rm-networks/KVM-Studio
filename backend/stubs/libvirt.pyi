class virConnect:
    def listAllDomains(self, flags: int = 0) -> list[virDomain]: ...
    def lookupByUUIDString(self, uuidstr: str) -> virDomain: ...
    def createXML(self, xmlDesc: str, flags: int = 0) -> virDomain: ...
    def getLibVersion(self) -> int: ...
    def getVersion(self) -> int: ...
    def getType(self) -> str: ...
    def getHostname(self) -> str: ...
    def getURI(self) -> str: ...
    def getCapabilities(self) -> str: ...
    def getInfo(self) -> list[Any]: ...
