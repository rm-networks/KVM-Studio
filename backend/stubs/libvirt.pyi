    def listAllNetworks(self, flags: int = 0) -> list[virNetwork]: ...
    def networkLookupByName(self, name: str) -> virNetwork: ...
    def networkDefineXML(self, xml: str) -> virNetwork: ...

def open(name: str | None = None) -> virConnect: ...
